# Copy to .env and fill in. Never commit .env.

# Model (OpenAI Chat Completions format). To go local, point these at vLLM or Ollama.
#   Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1   LLM_API_KEY=ollama
#   vLLM:   LLM_BASE_URL=http://127.0.0.1:8001/v1    LLM_API_KEY=local
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# direct = our code gathers context + one model call; openclaw = agent runs inside OpenClaw
AGENT_MODE=direct

# Log generator
LOG_RATE_PER_SEC=1
ERROR_RATE=0.1
WARN_RATE=0.05

# Incidents
ESCALATION_SECONDS=120
GROUP_WINDOW_SECONDS=300

# OpenClaw (Phase 4, Dell only)
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=
SHARED_DIR=./shared

# Server
HOST=127.0.0.1
PORT=8000

# Alerts (python -m backend.alerts). openclaw: OpenClaw posts via its webhook (needs OPENCLAW_HOOK_*);
# direct: Telegram Bot API fallback (needs TELEGRAM_BOT_TOKEN). Never commit tokens.
ALERT_VIA=openclaw
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Lowest severity that gets posted: Low, Medium, High or Critical
TELEGRAM_MIN_SEVERITY=High
